const icon = getIconData(key);
---

<svg
  class={`tech-icon ${className ?? ''}`}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  aria-hidden="true"
  focusable="false"
  style={`color: ${icon.color}; flex-shrink: 0;`}
  set:html={icon.svg}
/>
