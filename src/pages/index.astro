---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import TechIcon from '../components/TechIcon.astro';
import CertificateModal from '../components/CertificateModal.astro';
import { profileData } from '../data/profile';
import { getCollection } from 'astro:content';
import { fetchGitHubRepoStats } from '../utils/github';
const gitHubStats = await fetchGitHubRepoStats('equalignorecase');
const sortedProjects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const hasResume = Boolean(profileData.resumeUrl);
const educationList = profileData.education.filter(e => !e.category || e.category === 'education');
const competitionList = profileData.education.filter(e => e.category === 'competition');
const certsWithIndex = (profileData.certificates || []).map((cert, index) => ({ ...cert, originalIndex: index }));
const awardCertificates = certsWithIndex.filter(c => !c.category || c.category === 'award');
const trainingCertificates = certsWithIndex.filter(c => c.category === 'training');
---
<BaseLayout>
  <section id="about" class="hero" aria-labelledby="intro-title">
    <div class="hero-main">
      <p class="availability"><span aria-hidden="true"></span>Available for Work</p>
      <h1 id="intro-title">{profileData.name}</h1>
      <p class="hero-role">
        <span
          class="typing-text"
          data-phrases={JSON.stringify([
            'Full-Stack Developer',
            'Software Engineer',
            'Fast Learner & Builder',
            'TypeScript & Python Specialist'
          ])}
        >
          {profileData.role}
        </span>
        <span class="typing-cursor" aria-hidden="true">|</span>
      </p>
      <p class="hero-bio">{profileData.bio}</p>
      <ul class="intro-highlights">{profileData.highlights.slice(0, 2).map(item => <li>{item}</li>)}</ul>
      <div class="hero-actions">
        <a href="#skills" class="button button-primary">ดูทักษะ<Icon name="arrow-down" /></a>
        {hasResume ? (
          <a href={profileData.resumeUrl} target="_blank" rel="noopener noreferrer" class="button button-secondary">เรซูเม่ (PDF)<Icon name="download" /></a>
        ) : (
          <a href="#contact" class="button button-secondary">ติดต่อ<Icon name="arrow-up-right" /></a>
        )}
      </div>
    </div>
    <aside class="profile-summary" aria-label="ข้อมูลเบื้องต้น">
      <p class="meta">ข้อมูลการทำงาน</p>
      <dl>
        <div><dt>ระดับประสบการณ์</dt><dd>Junior / จบใหม่</dd></div>
        <div><dt>ที่อยู่ปัจจุบัน</dt><dd>{profileData.location}</dd></div>
        <div><dt>รูปแบบงานที่มองหา</dt><dd>{profileData.availability}</dd></div>
      </dl>
    </aside>
  </section>
  <section id="skills" aria-labelledby="skills-title">
    <div class="section-header">
      <h2 id="skills-title" class="section-title">ทักษะและเครื่องมือ</h2>
      <span class="meta font-mono">Tech Stack</span>
    </div>
    <div class="skills-grid">
      {profileData.skills.map(group => (
        <div class="skill-group">
          <h3>{group.category}</h3>
          <ul>
            {group.items.map(skill => (
              <li>
                <span class="skill-name">
                  <TechIcon name={skill} size={18} />
                  <span>{skill}</span>
                </span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>
  <section id="education" aria-labelledby="education-title">
    <div class="section-header">
      <h2 id="education-title" class="section-title">การศึกษาและการอบรม</h2>
      <span class="meta font-mono">Education & Competitions</span>
    </div>
    <div class="education-columns">
      <div class="education-col">
        <div class="education-col-header">
          <h3 class="education-col-title">การศึกษาและประสบการณ์</h3>
          <span class="meta font-mono">{educationList.length} รายการ</span>
        </div>
        <div class="education-compact-list">
          {educationList.map(edu => (
            <article class="education-compact-card">
              <div class="education-compact-top">
                <span class="institution" title={edu.institution}>{edu.institution}</span>
                <span class="meta font-mono">{edu.period}</span>
              </div>
              <h4 class="education-compact-title">
                {('link' in edu && edu.link) ? (
                  <a href={edu.link} target="_blank" rel="noopener noreferrer">
                    {edu.title}<Icon name="arrow-up-right" />
                  </a>
                ) : edu.title}
              </h4>
              <p class="education-compact-desc">{edu.description}</p>
            </article>
          ))}
        </div>
      </div>

      <div class="education-col">
        <div class="education-col-header">
          <h3 class="education-col-title">การแข่งขันและการอบรม</h3>
          <span class="meta font-mono">{competitionList.length} รายการ</span>
        </div>
        <div class="education-compact-list">
          {competitionList.map(edu => (
            <article class="education-compact-card">
              <div class="education-compact-top">
                <span class="institution" title={edu.institution}>{edu.institution}</span>
                <span class="meta font-mono">{edu.period}</span>
              </div>
              <h4 class="education-compact-title">
                {('link' in edu && edu.link) ? (
                  <a href={edu.link} target="_blank" rel="noopener noreferrer">
                    {edu.title}<Icon name="arrow-up-right" />
                  </a>
                ) : edu.title}
              </h4>
              <p class="education-compact-desc">{edu.description}</p>
            </article>
          ))}
        </div>
      </div>
    </div>

    {profileData.certificates && profileData.certificates.length > 0 && (
      <div id="certificates" class="certificates-wrapper">
        <div class="certificates-header">
          <div>
            <h3 id="certificates-title" class="certificates-title">เกียรติบัตรและผลงานการแข่งขัน</h3>
            <p class="certificates-subtitle">รางวัลการแข่งขันทักษะวิชาชีพระดับชาติ/ภาคกลาง และวุฒิบัตรการอบรม</p>
          </div>
          <div class="cert-tabs" role="tablist" aria-label="หมวดหมู่เกียรติบัตร">
            <button
              type="button"
              role="tab"
              id="tab-btn-award"
              class="cert-tab-btn is-active"
              aria-selected="true"
              aria-controls="cert-panel-award"
              data-tab-target="award"
            >
              <span>รางวัลการแข่งขัน</span>
              <span class="cert-tab-count font-mono">{awardCertificates.length}</span>
            </button>
            <button
              type="button"
              role="tab"
              id="tab-btn-training"
              class="cert-tab-btn"
              aria-selected="false"
              aria-controls="cert-panel-training"
              data-tab-target="training"
            >
              <span>วุฒิบัตรการอบรม</span>
              <span class="cert-tab-count font-mono">{trainingCertificates.length}</span>
            </button>
          </div>
        </div>

        <div
          id="cert-panel-award"
          class="certificates-grid cert-tab-panel is-active"
          role="tabpanel"
          aria-labelledby="tab-btn-award"
        >
          {awardCertificates.map(cert => (
            <button
              type="button"
              class="certificate-card"
              data-cert-index={cert.originalIndex}
              title={`${cert.title} - คลิกเพื่อดูรูปขนาดเต็ม`}
              aria-haspopup="dialog"
            >
              <div class="certificate-thumb-wrap">
                <img
                  src={cert.image}
                  alt={cert.title}
                  loading="lazy"
                  decoding="async"
                  class="certificate-thumb"
                />
                <span class="certificate-zoom-badge">
                  <Icon name="arrow-up-right" />
                  <span>ดูรูปเต็ม</span>
                </span>
              </div>
              <div class="certificate-info">
                <div class="certificate-meta">
                  <span class="certificate-issuer">{cert.issuer}</span>
                  <span class="certificate-year font-mono">{cert.date}</span>
                </div>
                <h4 class="certificate-name">{cert.title}</h4>
                <p class="certificate-desc">{cert.description}</p>
              </div>
            </button>
          ))}
        </div>

        <div
          id="cert-panel-training"
          class="certificates-grid cert-tab-panel"
          role="tabpanel"
          aria-labelledby="tab-btn-training"
          hidden
        >
          {trainingCertificates.map(cert => (
            <button
              type="button"
              class="certificate-card"
              data-cert-index={cert.originalIndex}
              title={`${cert.title} - คลิกเพื่อดูรูปขนาดเต็ม`}
              aria-haspopup="dialog"
            >
              <div class="certificate-thumb-wrap">
                <img
                  src={cert.image}
                  alt={cert.title}
                  loading="lazy"
                  decoding="async"
                  class="certificate-thumb"
                />
                <span class="certificate-zoom-badge">
                  <Icon name="arrow-up-right" />
                  <span>ดูรูปเต็ม</span>
                </span>
              </div>
              <div class="certificate-info">
                <div class="certificate-meta">
                  <span class="certificate-issuer">{cert.issuer}</span>
                  <span class="certificate-year font-mono">{cert.date}</span>
                </div>
                <h4 class="certificate-name">{cert.title}</h4>
                <p class="certificate-desc">{cert.description}</p>
              </div>
            </button>
          ))}
        </div>

        <CertificateModal certificates={profileData.certificates} />
      </div>
    )}
  </section>
  <section id="projects" aria-labelledby="projects-title">
    <div class="section-header">
      <h2 id="projects-title" class="section-title">ผลงานที่คัดเลือก</h2>
      <span class="meta font-mono">{sortedProjects.length} projects</span>
    </div>
    <div class="project-grid">
      {sortedProjects.map((project, index) => (
        <article
          id={`project-${project.id}`}
          class={`project-card ${index === 0 ? 'project-card-featured' : ''}`}
          aria-labelledby={`project-title-${project.id}`}
        >
          <div class="project-card-header">
            <div class="project-card-meta">
              <span class="project-number">{String(index + 1).padStart(2, '0')}</span>
              <span class="meta font-mono">{project.data.year}</span>
            </div>
            <span class="project-role-badge">{project.data.role}</span>
          </div>
          <div class="project-body">
            <h3 id={`project-title-${project.id}`}>{project.data.name}</h3>
            <p class="project-tagline">{project.data.tagline}</p>
            <p class="project-summary">{project.data.summary}</p>
            <div class="project-highlights">
              <h4>สิ่งที่พัฒนา</h4>
              <ul class="detail-list">{project.data.highlights.slice(0, 2).map(point => <li>{point}</li>)}</ul>
            </div>
            <ul class="tech-list" aria-label="เทคโนโลยีที่ใช้">
              {project.data.techStack.map(tech => (
                <li class="tech-badge">
                  <TechIcon name={tech} size={14} />
                  <span>{tech}</span>
                </li>
              ))}
            </ul>
            <div class="project-actions">
              {project.data.repoUrl && (
                <div class="project-links-wrap">
                  <a class="button button-secondary project-github-btn" href={project.data.repoUrl} target="_blank" rel="noopener noreferrer">
                    <TechIcon name="github" size={16} />
                    <span>ดูโค้ดบน GitHub</span>
                    <Icon name="arrow-up-right" />
                  </a>

                  {(() => {
                    const repoName = project.data.repoUrl.replace(/\/$/, '').split('/').pop()?.toLowerCase() || '';
                    const stats = gitHubStats[repoName] || { stars: 0, forks: 0 };
                    return (
                      <div class="github-stats-bar" title={`สถิติสดจาก GitHub (${repoName})`}>
                        <span class="github-stat-pill" title={`${stats.stars} Stars บน GitHub`}>
                          <Icon name="star" />
                          <span class="font-mono">{stats.stars}</span>
                        </span>
                        <span class="github-stat-pill" title={`${stats.forks} Forks บน GitHub`}>
                          <Icon name="fork" />
                          <span class="font-mono">{stats.forks}</span>
                        </span>
                      </div>
                    );
                  })()}
                </div>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>
  <section id="contact" class="contact-section" aria-labelledby="contact-title">
    <div class="contact-intro"><h2 id="contact-title" class="section-title">ช่องทางติดต่อ</h2><p>สนใจร่วมงาน นัดสัมภาษณ์<br />หรือสอบถามเกี่ยวกับผลงาน</p></div>
    <div class="contact-list">
      {profileData.contacts.map(contact => (
        <a href={contact.href} target={contact.href.startsWith('http') ? '_blank' : undefined} rel={contact.href.startsWith('http') ? 'noopener noreferrer' : undefined}>
          <span class="contact-label">{contact.label}</span><span class="contact-value">{contact.value}</span><Icon name="arrow-up-right" />
        </a>
      ))}
    </div>
  </section>
  <script>
    function initCertTabs() {
      const tabBtns = document.querySelectorAll<HTMLButtonElement>('.cert-tab-btn');
      const tabPanels = document.querySelectorAll<HTMLElement>('.cert-tab-panel');

      tabBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const target = btn.getAttribute('data-tab-target');
          tabBtns.forEach(b => {
            const active = b === btn;
            b.classList.toggle('is-active', active);
            b.setAttribute('aria-selected', String(active));
          });
          tabPanels.forEach(panel => {
            const match = panel.id === `cert-panel-${target}`;
            panel.classList.toggle('is-active', match);
            if (match) {
              panel.removeAttribute('hidden');
              panel.querySelectorAll('.certificate-card').forEach(c => c.classList.add('is-revealed'));
            } else {
              panel.setAttribute('hidden', '');
            }
          });
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCertTabs);
    } else {
      initCertTabs();
    }
  </script>
</BaseLayout>
