---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profileData } from '../data/profile';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const sortedProjects = allProjects.sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout>
  <!-- 1. แนะนำตัว (Hero Section ที่คนทุกสายงานอ่านเข้าใจทันที) -->
  <section id="about" class="scroll-mt-16">
    <div class="modern-card relative overflow-hidden">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div class="space-y-4 max-w-2xl">
          <!-- ป้ายสถานะพร้อมเริ่มงาน -->
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-medium bg-tokyo-green/10 text-tokyo-green border border-tokyo-green/30">
            <span class="w-2 h-2 rounded-full bg-tokyo-green animate-pulse"></span>
            <span>พร้อมเริ่มงาน ({profileData.availability})</span>
          </div>

          <div>
            <h1 class="text-2xl sm:text-3xl font-bold text-tokyo-heading tracking-tight">
              {profileData.name}
            </h1>
            <p class="text-base sm:text-lg font-medium text-tokyo-blue mt-1">
              {profileData.role}
            </p>
          </div>

          <p class="text-sm sm:text-base leading-relaxed text-tokyo-text">
            {profileData.bio}
          </p>

          <!-- จุดเด่น 3 ข้อ อ่านกวาดสายตาง่าย -->
          <ul class="space-y-2 text-sm text-tokyo-text/90 pt-1">
            {
              profileData.highlights.map((item) => (
                <li class="flex items-start gap-2.5">
                  <span class="text-tokyo-mint font-bold mt-0.5">✓</span>
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>

          <!-- ปุ่มกดหลัก ชัดเจนสำหรับ HR -->
          <div class="flex flex-wrap items-center gap-3 pt-3">
            <a
              href="#projects"
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg text-sm font-semibold bg-tokyo-blue text-white dark:text-[#0D0E14] hover:opacity-90 transition-opacity"
            >
              <span>ดูผลงานโปรเจกต์</span>
              <span>↓</span>
            </a>
            <a
              href={profileData.resumeUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg text-sm font-semibold border border-tokyo-purple/50 bg-tokyo-purple/10 text-tokyo-purple hover:bg-tokyo-purple/20 transition-colors"
            >
              <span>ดาวน์โหลดเรซูเม่ (PDF)</span>
              <span>↗</span>
            </a>
            <a
              href="#contact"
              class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg text-sm font-medium border border-tokyo-border bg-tokyo-window text-tokyo-text hover:border-tokyo-mint hover:text-tokyo-mint transition-colors"
            >
              <span>ข้อมูลติดต่อ</span>
            </a>
          </div>
        </div>

        <!-- กล่องสรุปข้อมูลสั้นด้านขวา (Quick Profile Summary) -->
        <div class="bg-tokyo-window border border-tokyo-border rounded-xl p-5 md:w-64 shrink-0 space-y-3.5 text-sm">
          <div class="text-xs font-mono uppercase tracking-wider text-tokyo-comment pb-2 border-b border-tokyo-border">
            ข้อมูลเบื้องต้น (Quick Info)
          </div>
          <div>
            <div class="text-xs text-tokyo-comment">สายงานที่สนใจ</div>
            <div class="font-semibold text-tokyo-heading mt-0.5">Full-Stack / Frontend</div>
          </div>
          <div>
            <div class="text-xs text-tokyo-comment">ระดับประสบการณ์</div>
            <div class="font-semibold text-tokyo-mint mt-0.5">Junior / จบใหม่พร้อมลุยงาน</div>
          </div>
          <div>
            <div class="text-xs text-tokyo-comment">ที่อยู่ปัจจุบัน</div>
            <div class="font-semibold text-tokyo-heading mt-0.5">{profileData.location}</div>
          </div>
          <div class="pt-2 border-t border-tokyo-border flex items-center gap-1.5">
            <span class="w-3 h-3 rounded-sm bg-tokyo-red"></span>
            <span class="w-3 h-3 rounded-sm bg-tokyo-amber"></span>
            <span class="w-3 h-3 rounded-sm bg-tokyo-green"></span>
            <span class="w-3 h-3 rounded-sm bg-tokyo-mint"></span>
            <span class="w-3 h-3 rounded-sm bg-tokyo-blue"></span>
            <span class="w-3 h-3 rounded-sm bg-tokyo-purple"></span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. ผลงานโปรเจกต์เด่น (Selected Projects) -->
  <section id="projects" class="scroll-mt-16">
    <div class="section-header">
      <h2 class="section-title">
        <span class="w-2.5 h-6 rounded-full bg-tokyo-blue inline-block"></span>
        <span>ผลงานโปรเจกต์เด่น (Selected Projects)</span>
      </h2>
      <span class="section-badge">{sortedProjects.length} Projects</span>
    </div>

    <div class="space-y-5">
      {
        sortedProjects.map((project, index) => (
          <article class="modern-card group">
            <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
              <div class="flex items-center gap-2">
                <span class="px-2.5 py-0.5 rounded-md text-xs font-mono font-semibold bg-tokyo-blue/15 text-tokyo-blue border border-tokyo-blue/30">
                  Project 0{index + 1}
                </span>
                <span class="text-xs font-medium text-tokyo-purple">
                  {project.data.role}
                </span>
              </div>
              <span class="text-xs font-mono text-tokyo-comment px-2.5 py-0.5 rounded bg-tokyo-window border border-tokyo-border">
                ปี {project.data.year}
              </span>
            </div>

            <h3 class="text-lg sm:text-xl font-bold text-tokyo-heading group-hover:text-tokyo-blue transition-colors mb-1">
              <a href={`/projects/${project.id}`}>
                {project.data.title}
              </a>
            </h3>

            <p class="text-xs sm:text-sm text-tokyo-cyan font-mono mb-3">
              {project.data.subtitle}
            </p>

            <p class="text-sm sm:text-[15px] leading-relaxed text-tokyo-text mb-4">
              {project.data.summary}
            </p>

            {project.data.metrics && (
              <div class="text-xs sm:text-sm font-medium px-4 py-2.5 rounded-lg bg-tokyo-window border-l-4 border-tokyo-green text-tokyo-green mb-4">
                จุดเด่นผลลัพธ์: {project.data.metrics}
              </div>
            )}

            <div class="mb-4">
              <div class="text-xs font-medium text-tokyo-comment mb-1.5">สิ่งที่พัฒนาในโปรเจกต์นี้:</div>
              <ul class="space-y-1.5 text-xs sm:text-sm text-tokyo-text/90">
                {project.data.highlights.map((point) => (
                  <li class="flex items-start gap-2">
                    <span class="text-tokyo-blue font-bold">•</span>
                    <span>{point}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- ป้ายเทคโนโลยีที่ใช้ -->
            <div class="flex flex-wrap gap-1.5 mb-5">
              {project.data.techStack.map((tech) => (
                <span class="tech-badge">{tech}</span>
              ))}
            </div>

            <!-- ปุ่มกดเข้าใจง่ายทั้งสำหรับ HR และ Developer -->
            <div class="flex flex-wrap items-center gap-3 pt-4 border-t border-tokyo-border/80 text-xs sm:text-sm font-medium">
              <a
                href={`/projects/${project.id}`}
                class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-tokyo-blue text-white dark:text-[#0D0E14] font-semibold hover:opacity-90 transition-opacity"
              >
                <span>อ่านรายละเอียดโปรเจกต์</span>
                <span>→</span>
              </a>
              {project.data.liveUrl && (
                <a
                  href={project.data.liveUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-tokyo-window border border-tokyo-border text-tokyo-mint hover:border-tokyo-mint transition-colors"
                >
                  <span>เปิดเว็บตัวอย่าง (Live Demo)</span>
                  <span>↗</span>
                </a>
              )}
              {project.data.repoUrl && (
                <a
                  href={project.data.repoUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-tokyo-window border border-tokyo-border text-tokyo-text hover:border-tokyo-purple hover:text-tokyo-purple transition-colors"
                >
                  <span>ดูโค้ดบน GitHub</span>
                  <span>↗</span>
                </a>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- 3. ทักษะและความสามารถ (Skills) -->
  <section id="skills" class="scroll-mt-16">
    <div class="section-header">
      <h2 class="section-title">
        <span class="w-2.5 h-6 rounded-full bg-tokyo-purple inline-block"></span>
        <span>ทักษะและเครื่องมือที่ใช้ (Skills & Tech Stack)</span>
      </h2>
      <span class="section-badge">Capabilities</span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      {
        profileData.skills.map((group) => (
          <div class="modern-card">
            <h3 class="text-sm font-bold text-tokyo-heading pb-2.5 mb-3.5 border-b border-tokyo-border flex items-center justify-between">
              <span>{group.category}</span>
              <span class="text-xs font-mono text-tokyo-purple">{group.items.length}</span>
            </h3>
            <div class="flex flex-wrap gap-2">
              {group.items.map((skill) => (
                <span class="px-3 py-1.5 rounded-lg text-xs font-medium bg-tokyo-window border border-tokyo-border text-tokyo-text">
                  {skill}
                </span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- 4. การศึกษาและใบรับรอง (Education & Certifications) -->
  <section id="education" class="scroll-mt-16">
    <div class="section-header">
      <h2 class="section-title">
        <span class="w-2.5 h-6 rounded-full bg-tokyo-amber inline-block"></span>
        <span>การศึกษาและการอบรม (Education & Certificates)</span>
      </h2>
      <span class="section-badge">Background</span>
    </div>

    <div class="space-y-4">
      {
        profileData.education.map((edu) => (
          <div class="modern-card">
            <div class="flex flex-wrap items-center justify-between gap-2 mb-1.5">
              <span class="text-xs font-medium text-tokyo-amber">
                {edu.institution}
              </span>
              <span class="text-xs font-mono px-2.5 py-0.5 rounded bg-tokyo-window border border-tokyo-border text-tokyo-cyan">
                {edu.period}
              </span>
            </div>

            <h3 class="text-base sm:text-lg font-bold text-tokyo-heading mb-1.5">
              {edu.link ? (
                <a
                  href={edu.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:text-tokyo-blue underline decoration-tokyo-border underline-offset-4"
                >
                  {edu.title} ↗
                </a>
              ) : (
                edu.title
              )}
            </h3>

            <p class="text-sm text-tokyo-text/90 leading-relaxed">
              {edu.description}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- 5. ช่องทางติดต่อ (Contact) -->
  <section id="contact" class="scroll-mt-16">
    <div class="section-header">
      <h2 class="section-title">
        <span class="w-2.5 h-6 rounded-full bg-tokyo-mint inline-block"></span>
        <span>ช่องทางติดต่อ (Contact)</span>
      </h2>
      <span class="section-badge">Get in Touch</span>
    </div>

    <div class="modern-card">
      <p class="text-sm text-tokyo-text mb-5">
        สนใจร่วมงาน นัดสัมภาษณ์ หรือสอบถามข้อมูลเพิ่มเติม ติดต่อได้ทุกช่องทางด้านล่าง:
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
        {
          profileData.contacts.map((contact) => (
            <a
              href={contact.href}
              target={contact.href.startsWith('http') ? '_blank' : undefined}
              rel={contact.href.startsWith('http') ? 'noopener noreferrer' : undefined}
              class="flex items-center justify-between p-4 rounded-xl bg-tokyo-window border border-tokyo-border hover:border-tokyo-mint group transition-colors"
            >
              <div>
                <div class="text-xs text-tokyo-comment mb-0.5">{contact.label}</div>
                <div class="text-sm text-tokyo-heading group-hover:text-tokyo-mint font-medium break-all">
                  {contact.value}
                </div>
              </div>
              <span class="text-tokyo-comment group-hover:text-tokyo-mint text-base ml-2">
                ↗
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
