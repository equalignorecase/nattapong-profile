---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import Icon from '../components/Icon.astro';
import { profileData } from '../data/profile';
interface Props {
  title?: string;
  description?: string;
  showBackLink?: boolean;
}
const {
  title = 'Nattapong | Portfolio',
  description = profileData.bio,
  showBackLink = false,
} = Astro.props;
const links = [
  { id: 'about', label: 'แนะนำตัว' },
  { id: 'skills', label: 'ทักษะ' },
  { id: 'education', label: 'การศึกษา' },
  { id: 'projects', label: 'ผลงาน' },
  { id: 'contact', label: 'ติดต่อ' },
];
---
<!doctype html>
<html lang="th" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Anuphan:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profileData.name} />

    <!-- Open Graph / Facebook / LINE / Discord -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://nattapong-profile.vercel.app/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://nattapong-profile.vercel.app/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content="https://nattapong-profile.vercel.app/" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://nattapong-profile.vercel.app/og-image.png" />

    <!-- JSON-LD Structured Data (Person & WebSite) -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'WebSite',
          '@id': 'https://nattapong-profile.vercel.app/#website',
          'url': 'https://nattapong-profile.vercel.app/',
          'name': 'Nattapong Nakaom — Developer Portfolio',
          'description': description,
          'inLanguage': 'th'
        },
        {
          '@type': 'Person',
          '@id': 'https://nattapong-profile.vercel.app/#person',
          'name': profileData.name,
          'jobTitle': profileData.role,
          'url': 'https://nattapong-profile.vercel.app/',
          'image': 'https://nattapong-profile.vercel.app/og-image.png',
          'sameAs': [
            'https://github.com/equalignorecase'
          ],
          'address': {
            '@type': 'PostalAddress',
            'addressLocality': profileData.location
          }
        }
      ]
    })} />
    <script is:inline>
      try {
        document.documentElement.classList.toggle('dark', localStorage.getItem('theme') !== 'light');
      } catch {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body>
    <div class="noise-texture" aria-hidden="true"></div>
    <a class="skip-link" href="#main-content">ข้ามไปเนื้อหา</a>
    <div class="site-shell">
      <header class="site-header">
        <a href="/" class="wordmark">
          <span class="wordmark-full">{profileData.name}</span>
          <span class="wordmark-short">นัฐพงษ์ นาคอ่วม</span>
        </a>
        <div class="header-actions">
          <nav class="desktop-nav" aria-label="เมนูหลัก">
            {showBackLink ? <a href="/" class="back-link"><Icon name="arrow-left" />กลับหน้าแรก</a> : links.map(link => <a href={`#${link.id}`}>{link.label}</a>)}
          </nav>
          <ThemeToggle />
          <details class="mobile-menu">
            <summary aria-label="เมนูหลัก"><Icon name="menu" /><span>เมนู</span></summary>
            <nav aria-label="เมนูมือถือ">
              {showBackLink && <a href="/">กลับหน้าแรก</a>}
              {links.map(link => <a href={`${showBackLink ? '/' : ''}#${link.id}`}>{link.label}</a>)}
            </nav>
          </details>
        </div>
      </header>
      <main id="main-content" tabindex="-1"><slot /></main>
      <footer class="site-footer">
        <span>© {new Date().getFullYear()} {profileData.name}</span>
        <span class="footer-stack">Astro / TypeScript / Tailwind CSS</span>
      </footer>
      <button
        type="button"
        id="back-to-top"
        class="back-to-top-btn"
        aria-label="ย้อนกลับขึ้นด้านบน"
        title="ย้อนกลับขึ้นด้านบน"
      >
        <Icon name="arrow-up" />
      </button>
    </div>
    <script>
      import { initPageEffects } from '../scripts/page-effects.js';

      initPageEffects();
      const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
      menu?.addEventListener('click', (event) => {
        if ((event.target as Element).closest('a')) menu.open = false;
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && menu?.open) {
          menu.open = false;
          menu.querySelector('summary')?.focus();
        }
      });
      document.addEventListener('click', (event) => {
        if (menu?.open && !menu.contains(event.target as Node)) {
          menu.open = false;
        }
      });

      const backToTopBtn = document.getElementById('back-to-top');
      if (backToTopBtn) {
        window.addEventListener('scroll', () => {
          backToTopBtn.classList.toggle('is-visible', window.scrollY > 350);
        }, { passive: true });
        backToTopBtn.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      }
    </script>
  </body>
</html>
